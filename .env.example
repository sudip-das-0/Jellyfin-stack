# Copy to /mnt/jellyfin/scripts/.env on each host (gitignored).
# Used by docker compose, systemd (EnvironmentFile=), and stack-paths.sh.

ARR_CONFIG_ROOT=/home/REPLACE_ME/arr/config

# --- LG TV library pipeline (continuous worker + new-media watcher) ---
# 1 = remux/transcode for LG WebOS direct play; 0 = Jellyfin transcodes at playback only.
LG_TV_OPTIMIZE_ENABLED=0
# Shrink when over this GiB/hour (0 = codec/subs policy only, no size-based re-encode).
LG_TV_MAX_GIB_PER_HOUR=0
# 1 = skip in-library Blu-ray REMUX (use lg-tv-export-processed.sh for manual REMUX exports).
LG_TV_SKIP_REMUX=1
LG_TV_SKIP_LOSSLESS_AUDIO=1
# Allow libx264 when Intel HW tiers fail (needed for some HEVC/HDR sources).
LG_TV_ALLOW_CPU_FALLBACK=0
