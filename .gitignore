# Runtime config (API keys, app databases, indexer defs)
config/

# Large host binaries (ffmpeg/alass); not source
bin/

# Logs live on /mnt/jellyfin/logs — never in repo
*.log
*.log.*
*.pid
*.lock
*.queue
*.tsv

# Python / editor
__pycache__/
scripts/
*.py[cod]
.env
.env.*
!.env.example
.venv-subsync/

# Rotated / local backups
*.old
*.bak
*~

# Host-only extras (show-specific policies, blocked titles, one-off scripts)
temp/
