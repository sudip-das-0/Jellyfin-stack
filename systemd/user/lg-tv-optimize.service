[Unit]
Description=LG TV optimize — continuous queue worker (one encode at a time)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=LG_TV_MAX_HEIGHT=0
ExecStart=/mnt/jellyfin/scripts/lg-tv-optimize-daemon.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
