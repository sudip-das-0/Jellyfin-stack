[Unit]
Description=LG TV optimize — continuous queue worker (one encode at a time)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=LG_TV_MAX_HEIGHT=0
Environment=LG_TV_HW_DECODE=1
Environment=LG_TV_AV1_QSV=1
Environment=LG_TV_AV1_HW_ATTEMPTS=3
Environment=LG_TV_QSV_DEVICE=/dev/dri/renderD128
Environment=LG_TV_VAAPI_DRIVER=iHD
Environment=LG_TV_OPTIMIZE_MAX_RETRIES=4
Environment=LG_TV_MAXRATE=15M
Environment=LG_TV_BUFSIZE=30M
Environment=LG_TV_TARGET_VBITRATE_BPS=15000000
Environment=LG_TV_MAX_GIB_PER_HOUR=5
Environment=LG_TV_H264_SHRINK=1
Environment=LG_TV_SKIP_REMUX=1
Environment=LG_TV_SKIP_LOSSLESS_AUDIO=1
Environment=LG_TV_SKIP_LOSSLESS_MIN_BYTES=8589934592
ExecStart=/mnt/jellyfin/scripts/lg-tv/lg-tv-optimize-daemon.sh
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
