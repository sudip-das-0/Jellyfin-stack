[Unit]
Description=Jellyfin and *arr Docker stack
Documentation=file:///home/devdas/arr/docker-compose.yml
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/devdas/arr
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=default.target
