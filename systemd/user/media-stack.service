[Unit]
Description=Jellyfin and *arr Docker stack
Documentation=file:///mnt/jellyfin/scripts/docker-compose.yml
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/jellyfin/scripts
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=default.target
