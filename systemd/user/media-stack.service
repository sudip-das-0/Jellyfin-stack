[Unit]
Description=Jellyfin and *arr Docker stack
Documentation=file:///mnt/jellyfin/scripts/docker-compose.yml
After=docker.service network-online.target mnt-jellyfin.mount
Wants=network-online.target mnt-jellyfin.mount
RequiresMountsFor=/mnt/jellyfin
ConditionPathIsMountPoint=/mnt/jellyfin

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/jellyfin/scripts
ExecStartPre=/mnt/jellyfin/scripts/ensure-jellyfin-media-mount.sh
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=default.target
