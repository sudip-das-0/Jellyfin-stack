[Unit]
Description=Queue LG TV optimize for newly imported media under /mnt/jellyfin/media
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/mnt/jellyfin/scripts/.env
ExecStart=/mnt/jellyfin/scripts/lg-tv/lg-tv-watch-new-media.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
